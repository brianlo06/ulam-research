<script>
/* ---------- Figure 4: information ladder + screening ---------- */
(function(){
  const W=880, H=330, s = svgIn('fig4', W, H);
  const C = D.info;
  const lad = C.ladder; // [[k,H],...]
  const bars = [
    {l:'H(g) — no conditioning', v:C.H_g, c:css('--muted')},
    {l:'H(g | g₋₁)', v:lad[1][1], c:css('--s1')},
    {l:'H(g | θ)  ← the hidden signal', v:C.H_g_th, c:css('--s2'), acc:true},
    {l:'H(g | g₋₁,g₋₂)', v:lad[2][1], c:css('--s1')},
    {l:'H(g | 3 gaps)', v:lad[3][1], c:css('--s1')},
    {l:'H(g | 4 gaps)', v:lad[4][1], c:css('--s1')},
    {l:'H(g | 5 gaps)', v:lad[5][1], c:css('--s1')},
    {l:'H(g | 6 gaps)', v:lad[6][1], c:css('--s1')},
    {l:'LZMA, unbounded context', v:C.lzma, c:css('--s1')},
  ];
  const L=252, R=120, T=16, rowH=26, gap=8;
  const xm = 3.6, x = v => L + (v/xm)*(W-L-R);
  niceTicks(0,3.5,7).forEach(v=>{ el('line',{x1:x(v),x2:x(v),y1:T,y2:T+bars.length*(rowH+gap),class:'gridline'},s);
    txt(s,x(v),T+bars.length*(rowH+gap)+16,fmt(v,1),{class:'tick','text-anchor':'middle'}); });
  bars.forEach((b,i)=>{
    const yy = T + i*(rowH+gap);
    const r = el('rect',{x:x(0),y:yy,width:Math.max(2,x(b.v)-x(0)),height:rowH,rx:4,
      fill:b.acc?css('--s2'):(i===0?css('--axis'):css('--s1'))},s);
    txt(s, L-10, yy+rowH/2+4, b.l, {class:'tick','text-anchor':'end', fill: b.acc?css('--s2'):null,
        'font-weight': b.acc?'600':null});
    txt(s, x(b.v)+8, yy+rowH/2+4, b.v.toFixed(2)+' bits', {class:'dl', fill:css('--ink2')});
    r.addEventListener('mousemove',ev=>showTT(ev,`${b.l}<br>${b.v.toFixed(4)} bits/gap`));
    r.addEventListener('mouseleave',hideTT);
  });
  // random baseline marker
  txt(s, W-R+8, T+64, 'random set of', {class:'tick'}); txt(s, W-R+8, T+77, 'equal density:', {class:'tick'});
  txt(s, W-R+8, T+92, '→ 5.14 bits', {class:'dl', fill:css('--muted')});
  txt(s,(L+W-R)/2,H-2,'bits per gap',{class:'axl','text-anchor':'middle'});
})();

/* ---------- Figure 5: diffusion + deviation ---------- */
(function(){
  const W=880, H=280, s = svgIn('fig5', W, H);
  // left panel
  const L=56, T=16, B=44, PW=430, R0=L+PW;
  const dd = D.diffusion; // [m, ratio, blocks]
  const xmin=Math.log10(1), xmax=Math.log10(70000);
  const x = m => L + (Math.log10(m)-xmin)/(xmax-xmin)*PW;
  const y = v => T + (1-v/1.1)*(H-T-B);
  [0,.25,.5,.75,1].forEach(v=>{ el('line',{x1:L,x2:R0,y1:y(v),y2:y(v),class:'gridline'},s);
    txt(s,L-8,y(v)+4,fmt(v,2),{class:'tick','text-anchor':'end'}); });
  el('line',{x1:L,x2:R0,y1:y(1),y2:y(1),stroke:css('--muted'),'stroke-dasharray':'4 3'},s);
  txt(s,R0-4,y(1)-6,'i.i.d. (=1)',{class:'dl','text-anchor':'end',fill:css('--muted')});
  // bounded-remainder guide ~ c/m
  let dg=''; for(let lm=0;lm<=4.5;lm+=.1){ const m=Math.pow(10,lm), v=Math.min(1, 1/m);
    dg += (dg?' L':'M')+` ${x(m)} ${y(v)}`; }
  el('path',{d:dg,fill:'none',stroke:css('--axis'),'stroke-dasharray':'2 3'},s);
  txt(s,x(4.2),y(0.16),'bounded remainder ∝ 1/m',{class:'dl',fill:css('--muted')});
  [1,10,100,1000,10000].forEach(m=>{ txt(s,x(m),H-B+16,m>=10000?'10⁴':(m>=1000?'10³':''+m),{class:'tick','text-anchor':'middle'}); });
  let dl=''; dd.forEach(([m,v])=>{ dl += (dl?' L':'M')+` ${x(m)} ${y(v)}`; });
  el('path',{d:dl,fill:'none',stroke:css('--s1'),'stroke-width':2},s);
  dd.forEach(([m,v,nb])=>{ const c=el('circle',{cx:x(m),cy:y(v),r:3.5,fill:css('--s1'),stroke:css('--surface'),'stroke-width':1.2},s);
    c.addEventListener('mousemove',ev=>showTT(ev,`m = ${fmt(m,0)}<br>Var ratio = ${v.toFixed(3)}<br>${fmt(nb,0)} blocks`));
    c.addEventListener('mouseleave',hideTT); });
  txt(s,(L+R0)/2,H-4,'block length m (log)',{class:'axl','text-anchor':'middle'});
  txt(s,14,(T+H-B)/2,'Var(Sₘ)/(m·Var g)',{class:'axl','text-anchor':'middle',transform:`rotate(-90 14 ${(T+H-B)/2})`});
  // right panel: deviation trace
  const L2=R0+72, R=16, PW2=W-L2-R;
  const dv = D.dev, n = dv.n, e = dv.e;
  const emax = Math.max(...e.map(Math.abs))*1.1;
  const x2 = i => L2 + (n[i]/n[n.length-1])*PW2;
  const y2 = v => T + (1-(v+emax)/(2*emax))*(H-T-B);
  el('line',{x1:L2,x2:W-R,y1:y2(0),y2:y2(0),class:'axisline'},s);
  [-6000,-3000,0,3000,6000].forEach(v=>{ if(Math.abs(v)<emax){
    el('line',{x1:L2,x2:W-R,y1:y2(v),y2:y2(v),class:'gridline'},s);
    txt(s,L2-6,y2(v)+4,v===0?'0':fmt(v/1000,0)+'k',{class:'tick','text-anchor':'end'});}});
  let dp=''; e.forEach((v,i)=>{ dp += (dp?' L':'M')+` ${x2(i).toFixed(1)} ${y2(v).toFixed(1)}`; });
  el('path',{d:dp,fill:'none',stroke:css('--s1'),'stroke-width':1.2},s);
  [0,1,2,3].forEach(k=>{ const i=Math.round(k*(n.length-1)/3);
    txt(s,x2(i),H-B+16,k===0?'0':fmt(n[i]/1e6,1)+'M',{class:'tick','text-anchor':'middle'}); });
  txt(s,(L2+W-R)/2,H-4,'term index n',{class:'axl','text-anchor':'middle'});
  txt(s,L2-46,(T+H-B)/2,'aₙ − n/d',{class:'axl','text-anchor':'middle',transform:`rotate(-90 ${L2-46} ${(T+H-B)/2})`});
})();

/* ---------- Figure 6: oligarchy ---------- */
(function(){
  const W=880, H=290, s = svgIn('fig6', W, H);
  const L=56, T=16, B=44, PW=430, R0=L+PW;
  const SC = D.share_curve;
  const xmax = Math.log10(SC.K[SC.K.length-1]);
  const x = k => L + Math.log10(Math.max(1,k))/xmax*PW;
  const y = v => T + (1-v)*(H-T-B);
  [0,.25,.5,.75,1].forEach(v=>{ el('line',{x1:L,x2:R0,y1:y(v),y2:y(v),class:'gridline'},s);
    txt(s,L-8,y(v)+4,(v*100)+'%',{class:'tick','text-anchor':'end'}); });
  [1,10,100,1e3,1e4,1e5].forEach(k=>{ if(Math.log10(k)<=xmax){
    txt(s,x(k),H-B+16,k>=1e5?'10⁵':(k>=1e4?'10⁴':(k>=1e3?'10³':''+k)),{class:'tick','text-anchor':'middle'});}});
  let dl=''; SC.K.forEach((k,i)=>{ dl += (dl?' L':'M')+` ${x(k)} ${y(SC.share[i])}`; });
  el('path',{d:dl,fill:'none',stroke:css('--s1'),'stroke-width':2},s);
  // annotate top-10 (exact from generator table)
  const s10 = D.topgen.reduce((a,t)=>a+t[3],0);
  el('circle',{cx:x(10),cy:y(s10),r:4,fill:css('--s2'),stroke:css('--surface'),'stroke-width':1.2},s);
  txt(s,x(10)+8,y(s10)-8,'top 10 → '+(s10*100).toFixed(1)+'%',{class:'dl',fill:css('--s2')});
  const hot = el('rect',{x:L,y:T,width:PW,height:H-T-B,fill:'transparent'},s);
  hot.addEventListener('mousemove',ev=>{
    const r=s.getBoundingClientRect(), mx=(ev.clientX-r.left)*W/r.width;
    const k=Math.pow(10,Math.max(0,(mx-L)/PW*xmax));
    let i=0; while(i<SC.K.length-1&&SC.K[i]<k)i++;
    showTT(ev,`top ${fmt(SC.K[i],0)} generators<br>${(SC.share[i]*100).toFixed(1)}% of parent slots`); });
  hot.addEventListener('mouseleave',hideTT);
  txt(s,(L+R0)/2,H-4,'generators, ranked by load (log)',{class:'axl','text-anchor':'middle'});
  txt(s,14,(T+H-B)/2,'share of all parent slots',{class:'axl','text-anchor':'middle',transform:`rotate(-90 14 ${(T+H-B)/2})`});
  // right: outlier birth log-log
  const L2=R0+72, R=16, PW2=W-L2-R;
  const Bh = D.birth;
  const xr=[1,Math.log10(Bh.n[Bh.n.length-1])], yr=[0,Math.log10(400)];
  const x2 = n => L2 + (Math.log10(n)-xr[0])/(xr[1]-xr[0])*PW2;
  const y2 = c => T + (1-(Math.log10(Math.max(1,c))-yr[0])/(yr[1]-yr[0]))*(H-T-B);
  [1,10,100].forEach(c=>{ el('line',{x1:L2,x2:W-R,y1:y2(c),y2:y2(c),class:'gridline'},s);
    txt(s,L2-6,y2(c)+4,''+c,{class:'tick','text-anchor':'end'}); });
  [10,100,1e3,1e4,1e5,1e6].forEach(n=>{ if(n>=10&&Math.log10(n)<=xr[1])
    txt(s,x2(n),H-B+16,n>=1e6?'10⁶':(n>=1e5?'10⁵':(n>=1e4?'10⁴':(n>=1e3?'10³':''+n))),{class:'tick','text-anchor':'middle'}); });
  // n^0.30 guide through last point
  const nl=Bh.n[Bh.n.length-1], cl=Bh.count[Bh.count.length-1];
  let dg2=''; for(let ln=1;ln<=xr[1];ln+=.15){ const n=Math.pow(10,ln), c=cl*Math.pow(n/nl,0.30);
    dg2 += (dg2?' L':'M')+` ${x2(n)} ${y2(c)}`; }
  el('path',{d:dg2,fill:'none',stroke:css('--axis'),'stroke-dasharray':'3 3'},s);
  txt(s,x2(1000),y2(1000*Math.pow(1000/nl,0.3)*cl/1000)-100,'',{});
  txt(s,L2+PW2*.45,T+30,'~n⁰·³⁰',{class:'dl',fill:css('--muted')});
  let db=''; Bh.n.forEach((n,i)=>{ if(n>=10){ db += (db?' L':'M')+` ${x2(n)} ${y2(Bh.count[i])}`; }});
  el('path',{d:db,fill:'none',stroke:css('--s1'),'stroke-width':2},s);
  Bh.n.forEach((n,i)=>{ if(n>=10 && i%4===0){ const c=el('circle',{cx:x2(n),cy:y2(Bh.count[i]),r:3,fill:css('--s1'),stroke:css('--surface'),'stroke-width':1},s);
    c.addEventListener('mousemove',ev=>showTT(ev,`first ${fmt(n,0)} terms<br>${Bh.count[i]} outliers`));
    c.addEventListener('mouseleave',hideTT); }});
  txt(s,(L2+W-R)/2,H-4,'terms n (log)',{class:'axl','text-anchor':'middle'});
  txt(s,L2-40,(T+H-B)/2,'outliers (log)',{class:'axl','text-anchor':'middle',transform:`rotate(-90 ${L2-40} ${(T+H-B)/2})`});
})();
</script>
